{
  "components": {
    "schemas": {
      "AssignmentRef": {
        "description": "A role held at org scope or within one team.",
        "properties": {
          "role": {
            "title": "Role",
            "type": "string"
          },
          "scope": {
            "enum": [
              "org",
              "team"
            ],
            "title": "Scope",
            "type": "string"
          },
          "team": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team"
          }
        },
        "required": [
          "role",
          "scope"
        ],
        "title": "AssignmentRef",
        "type": "object"
      },
      "Me": {
        "description": "`GET /v1/me`: who the token belongs to, in which tenant, and what they hold.",
        "properties": {
          "assignments": {
            "items": {
              "$ref": "#/components/schemas/AssignmentRef"
            },
            "title": "Assignments",
            "type": "array"
          },
          "kind": {
            "enum": [
              "human",
              "service"
            ],
            "title": "Kind",
            "type": "string"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantRef"
          },
          "token_expires_at": {
            "format": "date-time",
            "title": "Token Expires At",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserRef"
          }
        },
        "required": [
          "user",
          "kind",
          "tenant",
          "token_expires_at"
        ],
        "title": "Me",
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem document. `code` is a stable machine name\n(`auth.invalid_token`, ...); `hint` is a next step the CLI prints as is. A problem never\nechoes a submitted secret and never names another tenant.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "hint": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hint"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "detail",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "db_enforced": {
            "title": "Db Enforced",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db_enforced"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "TenantRef": {
        "description": "The caller's tenant, as the server derived it from the token.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ],
        "title": "TenantRef",
        "type": "object"
      },
      "TokenInfo": {
        "description": "A token without its value.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "current": {
            "default": false,
            "title": "Current",
            "type": "boolean"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revoked_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revoked At"
          }
        },
        "required": [
          "id",
          "name",
          "created_at",
          "expires_at"
        ],
        "title": "TokenInfo",
        "type": "object"
      },
      "TokenIssued": {
        "description": "The one response that carries a token value; it is never shown again.",
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "token",
          "expires_at"
        ],
        "title": "TokenIssued",
        "type": "object"
      },
      "TokenRequest": {
        "additionalProperties": false,
        "description": "`POST /v1/tokens`: a new token for the caller (rotation). `days` defaults to the\nlongest lifetime the caller's kind allows (90 for people, 365 for service accounts).",
        "properties": {
          "days": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Days"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "revoke_current": {
            "default": false,
            "title": "Revoke Current",
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "title": "TokenRequest",
        "type": "object"
      },
      "UserRef": {
        "properties": {
          "display_name": {
            "default": "",
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "UserRef",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "A control-plane token (`acp_...`) from `agentic login --for control-plane`",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "agentic control plane",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Liveness: the process answers. Never touches the database.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Readiness: the database answers, is migrated to this release and enforces tenant\nisolation and insert-only evidence (fail closed unless relaxed for development).",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "An RFC 9457 problem document"
          }
        },
        "summary": "Readyz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "description": "Who the token belongs to, in which tenant, and the roles they hold.",
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "An RFC 9457 problem document"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/tokens": {
      "get": {
        "description": "The caller's tokens, without values.",
        "operationId": "get_tokens_v1_tokens_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TokenInfo"
                  },
                  "title": "Response Get Tokens V1 Tokens Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "An RFC 9457 problem document"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Tokens",
        "tags": [
          "auth"
        ]
      },
      "post": {
        "description": "A new token for the caller in the caller's tenant (rotation). The value is in this\nresponse only. `revoke_current` revokes the token that made the request.",
        "operationId": "create_token_v1_tokens_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenIssued"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "An RFC 9457 problem document"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Token",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/tokens/{id}": {
      "delete": {
        "description": "Revoke one of the caller's tokens. Anyone else's token - in this tenant or another -\nanswers like a missing one.",
        "operationId": "delete_token_v1_tokens__id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              },
              "application/problem+json": {}
            },
            "description": "An RFC 9457 problem document"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Delete Token",
        "tags": [
          "auth"
        ]
      }
    }
  }
}
