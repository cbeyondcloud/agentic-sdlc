          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT run_id, team, started_by, budget_usd, reported_usd, ROUND(100 * reported_usd / NULLIF(budget_usd, 0), 1) AS burn_pct FROM dash_runs WHERE status = 'open' AND $__timeFilter(opened_at) ORDER BY burn_pct DESC NULLS LAST",
