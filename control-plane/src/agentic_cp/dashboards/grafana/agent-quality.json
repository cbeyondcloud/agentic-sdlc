          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT gate, COUNT(*) AS decisions, ROUND(AVG(waited_ms) / 1000.0, 1) AS avg_wait_s, ROUND(MAX(waited_ms) / 1000.0, 1) AS max_wait_s FROM dash_gates WHERE event = 'gate_decided' AND waited_ms IS NOT NULL AND $__timeFilter(at) GROUP BY gate ORDER BY avg_wait_s DESC",
