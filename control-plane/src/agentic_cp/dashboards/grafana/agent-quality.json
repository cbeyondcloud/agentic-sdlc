          "rawSql": "SELECT approver, COUNT(*) FILTER (WHERE decision = 'approve') AS approvals, COUNT(*) FILTER (WHERE decision = 'reject') AS rejections, COUNT(*) FILTER (WHERE forced) AS forced FROM dash_gates WHERE event = 'gate_decided' AND $__timeFilter(at) GROUP BY approver ORDER BY 2 DESC",
