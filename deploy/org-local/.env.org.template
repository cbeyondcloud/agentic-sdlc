# Local org stack - settings. up.sh / up.ps1 copy this file to .env.org (git-ignored) on
# first run and fill every EMPTY value in the "Generated" block once. The "Gateway" block is
# copied from the LITE stack's .env.lite on every up. Edit .env.org, not this file. One
# KEY=value per line, no quotes, no spaces around '='.

# -- Network ------------------------------------------------------------------
# Address the published ports bind to. 127.0.0.1 = this machine only.
ORG_BIND=127.0.0.1
ORG_CP_PORT=8090
ORG_GRAFANA_PORT=3300

# -- Tenant -------------------------------------------------------------------
ORG_TENANT=local
ORG_ADMIN_EMAIL=admin@org.local
# The tenant's Grafana reader role (it reads the dash_* views only, its own tenant's rows).
AGENTIC_DASH_READER=grafana_local

# -- Generated (leave empty; up fills them once and keeps them) ----------------
CP_SUPERUSER_PASSWORD=
CP_OWNER_PASSWORD=
CP_APP_PASSWORD=
AGENTIC_DASH_READER_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# -- Gateway (copied from the LITE stack's .env.lite by every up) --------------
GATEWAY_TENANT=
GATEWAY_DB_PASSWORD=
